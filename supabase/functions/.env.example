# Окружение Edge Functions для ЛОКАЛЬНОГО стека: скопировать в supabase/functions/.env
# (он в .gitignore) и запускать `npm run fn:serve`.
# Значения ниже фейковые и годятся только локально. В облаке TELEGRAM_BOT_TOKEN, ADMIN_TG_ID и APP_URL
# задаёт деплой (.github/workflows/deploy.yml → supabase secrets set, см. DEPLOY.md);
# TELEGRAM_DRY_RUN в облаке НЕ задавать. SUPABASE_URL и ключи проекта платформа кладёт сама.
# Секрета cron здесь нет: он живёт только в Vault (миграция 011), cron-tick сверяет заголовок
# x-cron-secret через RPC verify_cron_secret. Локально seed.sql ставит его 'local-cron-secret'.

# Токен бота. Локально — фейковый: им же подписывает initData dev-вход фронта (VITE_DEV_BOT_TOKEN).
TELEGRAM_BOT_TOKEN=123456:LOCAL_FAKE_TOKEN
# Telegram id админа клуба: входит всегда и получает is_admin. 1001 — админ из seed.sql.
ADMIN_TG_ID=1001
# Адрес Mini App (фронт).
APP_URL=http://127.0.0.1:5174
# 1 — не ходить в Telegram: посты и проверки членства только пишутся в лог функции.
TELEGRAM_DRY_RUN=1
