# Переменные фронта (Vite). Для локальной разработки скопировать в `.env.development.local`
# (в git не попадает по маске *.local и читается только `vite dev`, поэтому прод-сборка
# никогда не увидит dev-токен). Прод-сборка берёт облачные URL и ключ из `.env.production` (в git:
# оба значения публичные).

# Адрес Supabase. Локально — API стека из `npm run db:start` (порт 57321).
VITE_SUPABASE_URL=http://127.0.0.1:57321

# Publishable-ключ (sb_publishable_...). Локальный печатает `npx supabase status`.
# Только publishable/anon: secret-ключ во фронт не кладём никогда.
VITE_SUPABASE_PUBLISHABLE_KEY=

# Только dev: фейковый токен бота для входа вне Telegram (экран выбора тестового игрока).
# Должен совпадать с TELEGRAM_BOT_TOKEN в supabase/functions/.env локального стека.
# Настоящий токен бота сюда не класть.
VITE_DEV_BOT_TOKEN=
