    "fn:serve": "supabase functions serve --env-file supabase/functions/.env"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "@tanstack/react-query": "^5.102.8",
    "qrcode": "^1.5.4",
